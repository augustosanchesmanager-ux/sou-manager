# =============================================================================
# SOU MANA.GER — Variáveis de Ambiente (modelo)
# Copie este arquivo para `.env.local` e preencha os valores reais.
# NUNCA commite `.env.local`. Este arquivo (.env.example) sim, pode ser versionado.
# =============================================================================

# Supabase (obrigatório para modo conectado)
# Obtenha em: https://app.supabase.com/project/[ref]/settings/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# Google Gemini (obrigatório para recursos de IA)
# Obtenha em: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=sua-chave-api-do-gemini

# Multi-schema (opcional — padrão: false)
# Quando true, tabelas de domínio são roteadas para schema barber/auto/club.
# Tabelas centrais (profiles, tenants, staff, audit_logs…) permanecem em public.
VITE_SUPABASE_MULTI_SCHEMA_ENABLED=false

# Mapa de hostnames para resolução de app (opcional)
# Exemplo: {"custom.domain":"barber"}
VITE_APP_HOSTNAME_MAP={}

# =============================================================================
# Variáveis utilizadas apenas em CI / scripts de deploy (não pelo front em runtime)
# Não definir em .env.local a menos que esteja executando localmente com suporte.
# =============================================================================

# Chave de serviço do Supabase (apenas CI/administração — NUNCA expor no front)
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-do-supabase

# URL da aplicação (utilizada por Edge Functions e convites de equipe)
# APP_URL=https://barber.soumanager.com

# Token do Vercel para promoção controlada de produção (apenas CI)
# VERCEL_TOKEN=seu-token-vercel
# VERCEL_TEAM_SCOPE=seu-time-vercel

# =============================================================================
# Modo demo local
# Quando VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY estão ausentes e o host
# é localhost/127.0.0.1, o app sobe em modo demo silencioso (dados emulados).
# Login demo: teste@soumanager.local / 12345678
# =============================================================================
