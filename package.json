{
  "name": "sou-mana.ger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ --no-errors-on-unmatched",
    "lint:fix": "biome check src/ --write --no-errors-on-unmatched",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "architecture:check": "node scripts/architecture/check.mjs",
    "architecture:ci": "node scripts/architecture/check.mjs --ci --baseline",
    "d8:build": "node scripts/d8/export-core.mjs",
    "d8:verify": "node scripts/d8/export-core.mjs --verify",
    "architecture:baseline": "node scripts/architecture/check.mjs --baseline",
    "architecture:strict": "node scripts/architecture/check.mjs --strict",
    "architecture:deps": "npx depcruise --config .dependency-cruiser.mjs --output-type dot src/ | dot -T svg > architecture.svg"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "dexie": "^4.4.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.0",
    "dependency-cruiser": "^18.3.1",
    "madge": "^8.0.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
